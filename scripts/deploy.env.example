# Copy to sympleone/.env.deploy (gitignored) and fill in FTP_PASSWORD.
# Do not commit .env.deploy.

FTP_HOST=ftp.amazon.globalitstaffing.com
FTP_USER=u850710200.amazonsp
FTP_PASSWORD=
FTP_PORT=21

# Frontend is published at https://amazon.globalitstaffing.com/amazon
FTP_REMOTE_DIR=/
VITE_BASE_PATH=/amazon/
VITE_API_BASE_URL=https://amazon.globalitstaffing.com/amazon/api
VITE_API_TIMEOUT_MS=30000
VITE_AUTH_RELAXED=false

# Backend source upload (FTP cannot start uvicorn by itself).
FTP_BACKEND_DIR=/backend
BACKEND_DIR=../sympleone-backend
